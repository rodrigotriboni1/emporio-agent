# OpenRouter API key (https://openrouter.ai/keys); never commit the real value.
OPENROUTER_API_KEY=
# PydanticAI model id used by Mel.
MODEL=openrouter:deepseek/deepseek-v4.1-flash
# Store clock: ISO 8601 with offset, or `now` for the real clock at -04:00.
EMPORIO_NOW=2026-03-25T10:00-04:00
# Twilio account SID for the optional WhatsApp route (leave all four blank to disable it).
TWILIO_ACCOUNT_SID=
# Twilio auth token: signs incoming webhooks and authenticates replies; never commit it.
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886 for the Sandbox.
TWILIO_WHATSAPP_FROM=
# Exact public URL set in Twilio's "When a message comes in", e.g. https://<tunnel>/whatsapp/twilio.
TWILIO_WEBHOOK_URL=
